<%- include('../layouts/header', { title: 'Fan & Player Portal' }) %>

<div style="margin-bottom: 4rem;">
  
  <!-- Welcome Banner for New Users -->
  <% if (typeof welcome !== 'undefined' && welcome) { %>
    <div style="background: linear-gradient(135deg, rgba(48, 209, 88, 0.18) 0%, rgba(14, 19, 32, 0.95) 100%); border: 1px solid rgba(48, 209, 88, 0.4); border-radius: 18px; padding: 1.25rem 1.75rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);">
      <div style="display: flex; align-items: center; gap: 12px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <div>
          <h3 style="color: #30d158; font-size: 1.15rem; font-weight: 800; margin-bottom: 2px;">Welcome to the Arena, <%= user.gamertag %>!</h3>
          <p style="color: #cbd5e1; font-size: 0.875rem; margin: 0;">Your Nowhere Esports Fan Passport has been activated with 500 Nowhere Coins bonus.</p>
        </div>
      </div>
      <span class="mono" style="background: rgba(48, 209, 88, 0.15); color: #30d158; padding: 4px 12px; border-radius: 8px; font-weight: 800; font-size: 0.8125rem;">+500 NC CREDITED</span>
    </div>
  <% } %>

  <!-- ========================================================================= -->
  <!-- 1. HOLOGRAPHIC FAN PASSPORT HEADER                                        -->
  <!-- ========================================================================= -->
  <div class="card" style="padding: 2.25rem; border-radius: 24px; border: 1px solid rgba(255, 42, 75, 0.35); background: radial-gradient(ellipse at 80% 20%, rgba(255, 42, 75, 0.18) 0%, rgba(18, 24, 38, 0.95) 60%, rgba(10, 14, 25, 0.98) 100%); margin-bottom: 2.5rem; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;">
      
      <!-- Left: Avatar, Gamertag, Clan & Tier -->
      <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
        <!-- Glowing Avatar Orb -->
        <div style="position: relative;">
          <div id="passport-avatar-display" style="width: 80px; height: 80px; border-radius: 22px; background: linear-gradient(135deg, rgba(255, 42, 75, 0.35), rgba(56, 189, 248, 0.2)); border: 2px solid var(--accent); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; box-shadow: 0 0 25px rgba(255, 42, 75, 0.45); cursor: pointer;" onclick="openProfileModal()" title="Click to customize avatar">
            <%= user.avatar || '🎮' %>
          </div>
          <span style="position: absolute; bottom: -4px; right: -4px; width: 18px; height: 18px; border-radius: 50%; background: #30d158; border: 3px solid #0e1320; box-shadow: 0 0 10px #30d158;"></span>
        </div>

        <div>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 0.35rem; flex-wrap: wrap;">
            <h1 id="passport-gamertag-display" style="font-size: 1.95rem; font-weight: 900; letter-spacing: -0.01em; color: #fff; margin: 0;">
              <%= user.gamertag %>
            </h1>
            <span id="passport-clan-display" style="background: rgba(255, 42, 75, 0.18); border: 1px solid rgba(255, 42, 75, 0.4); color: var(--accent); padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 0.7rem;" class="mono">
              <%= user.clan || 'NOWHERE ARMY' %>
            </span>
            <span style="background: rgba(48, 209, 88, 0.15); color: #30d158; padding: 2px 8px; border-radius: 6px; font-weight: 700; font-size: 0.7rem;">
              ✓ VERIFIED FAN
            </span>
            <button type="button" onclick="openProfileModal()" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #cbd5e1; padding: 2px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; cursor: pointer;">
              Edit
            </button>
          </div>

          <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; color: var(--text-muted); font-size: 0.84rem;">
            <span>Favorite: <strong id="passport-game-display" style="color: #38bdf8;"><%= user.favoriteGame || 'VALORANT' %></strong></span>
            <span>&bull;</span>
            <span>Region: <strong style="color: #cbd5e1;"><%= user.region || 'India / South Asia' %></strong></span>
            <span>&bull;</span>
            <span class="mono" style="color: #64748b;">UID: <strong style="color: #fff;"><%= user.id %></strong></span>
          </div>
        </div>
      </div>

      <!-- Right: Level, XP Progress Bar & Nowhere Coins -->
      <div style="min-width: 280px; flex: 1; max-width: 400px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <div style="font-size: 0.8125rem; font-weight: 800; color: #f59e0b; text-transform: uppercase;" class="mono">
            LEVEL <%= user.level %> &bull; <%= user.tier %>
          </div>
          <div class="mono" style="font-size: 0.8125rem; color: #cbd5e1;">
            <span id="user-xp-display"><%= user.xp %></span> / <span id="user-maxxp-display"><%= user.maxXp %></span> XP
          </div>
        </div>

        <!-- Animated XP Progress Bar -->
        <div style="width: 100%; height: 10px; background: rgba(0, 0, 0, 0.6); border-radius: 9999px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 1rem;">
          <% const pct = Math.min(100, Math.round((user.xp / user.maxXp) * 100)); %>
          <div id="user-xp-bar" style="width: <%= pct %>%; height: 100%; background: linear-gradient(90deg, #ff2a4b, #f59e0b); border-radius: 9999px; transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);"></div>
        </div>

        <!-- Coin Balance & Actions -->
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(245, 158, 11, 0.3); padding: 6px 14px; border-radius: 12px;" class="mono">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <span style="font-size: 1.1rem; font-weight: 900; color: #f59e0b;" id="user-coins-display"><%= user.coins %></span>
            <span style="font-size: 0.7rem; color: #94a3b8;">NOWHERE COINS</span>
          </div>

          <a href="#rewards-shop-section" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #f59e0b; padding: 0.5rem 1rem; border-radius: 10px; font-weight: 800; font-size: 0.8125rem; text-decoration: none;">
            Fan Shop
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. DAILY FAN DROPS & LOGIN STREAK                                         -->
  <!-- ========================================================================= -->
  <div class="card" style="padding: 1.75rem 2rem; border-radius: 20px; border-color: rgba(245, 158, 11, 0.35); background: rgba(18, 24, 38, 0.9); margin-bottom: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #f59e0b; font-size: 0.7rem; font-weight: 800; text-transform: uppercase;" class="mono">
          DAILY FAN REWARDS &bull; STREAK: <%= user.streak %> DAYS
        </div>
        <h2 style="font-size: 1.45rem; font-weight: 900; color: #fff; margin-top: 4px; text-transform: uppercase;">
          Claim Today's Fan Loot Drop
        </h2>
      </div>

      <button id="claim-drop-btn" onclick="claimDailyDrop()" <%= user.claimedToday ? 'disabled' : '' %> style="<%= user.claimedToday ? 'background: rgba(255, 255, 255, 0.08); color: #94a3b8; border: 1px solid rgba(255, 255, 255, 0.1); cursor: not-allowed;' : 'background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #000; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.45); cursor: pointer;' %> border: none; padding: 0.65rem 1.75rem; border-radius: 12px; font-weight: 900; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.2s ease;">
        <%= user.claimedToday ? '✓ Claimed for Today' : 'Claim +250 XP & 100 Coins' %>
      </button>
    </div>

    <!-- 7-Day Streak Calendar Track -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 10px;">
      <% for (let i = 1; i <= 7; i++) { %>
        <% 
          const isDone = i < user.streak || (i === user.streak && user.claimedToday);
          const isToday = i === user.streak && !user.claimedToday;
        %>
        <div style="background: <%= isDone ? 'rgba(48, 209, 88, 0.12)' : (isToday ? 'rgba(245, 158, 11, 0.15)' : 'rgba(8, 12, 22, 0.6)') %>; border: 1px solid <%= isDone ? 'rgba(48, 209, 88, 0.4)' : (isToday ? 'rgba(245, 158, 11, 0.5)' : 'rgba(255, 255, 255, 0.06)') %>; border-radius: 12px; padding: 0.85rem 0.6rem; text-align: center;">
          <div style="font-size: 0.7rem; color: <%= isDone ? '#30d158' : (isToday ? '#f59e0b' : '#64748b') %>; font-weight: 800;" class="mono">
            DAY <%= i %>
          </div>
          <div style="font-size: 1.1rem; font-weight: 800; color: <%= isDone ? '#30d158' : (isToday ? '#f59e0b' : '#cbd5e1') %>; margin: 6px 0;">
            <%= isDone ? '✓' : (isToday ? '●' : '○') %>
          </div>
          <div style="font-size: 0.75rem; color: #cbd5e1; font-weight: 700;">
            <%= i === 7 ? '+500 NC' : `+${i * 50} NC` %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 3. LIVE MATCH STREAM LOUNGE & FAN MVP VOTE                                -->
  <!-- ========================================================================= -->
  <div style="display: grid; grid-template-columns: 2fr 1.2fr; gap: 2rem; margin-bottom: 2.5rem;" class="portal-grid">
    
    <!-- Left: Watch Stream Theater Feed -->
    <div class="card" style="padding: 1.75rem; border-radius: 20px; border-color: rgba(255, 42, 75, 0.35); position: relative;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; background: rgba(255, 42, 75, 0.15); color: #ff2a4b; font-size: 0.7rem; font-weight: 800;" class="mono">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #ff2a4b; display: inline-block;"></span>
            LIVE BROADCAST FEED
          </div>
          <h2 style="font-size: 1.4rem; font-weight: 900; color: #fff; margin-top: 4px;">
            Match Theater: <%= user.favoriteGame || 'VALORANT' %>
          </h2>
        </div>

        <button onclick="openStreamModal('5W8f7m4X6lI', 'Nowhere Esports Live Clean Feed', '<%= user.favoriteGame || 'VALORANT' %>', 'Grand Finals • 1080p60')" style="background: var(--accent); color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 800; font-size: 0.8125rem; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <span>▶</span> Full Theater Mode
        </button>
      </div>

      <!-- Embedded Clean Feed Preview -->
      <div id="stream-preview-box" style="position: relative; width: 100%; padding-bottom: 56.25%; border-radius: 14px; overflow: hidden; background: #000; border: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 1rem;">
        <iframe 
          id="portal-inline-stream"
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
          src="https://www.youtube-nocookie.com/embed/5W8f7m4X6lI?autoplay=0&rel=0"
          title="Live Match Player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
        <!-- Floating Reactions Container -->
        <div id="floating-reactions-area" style="position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 5;"></div>
      </div>

      <!-- Match Info & Floating Reaction Emojis -->
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
        <div style="font-size: 0.8125rem; color: #94a3b8;" class="mono">
          NOWHERE (13) vs SENTINELS (9) &bull; MAP 2: BIND &bull; <span style="color: #ff2a4b; font-weight: 700;">382,400 WATCHING</span>
        </div>

        <!-- Quick Hype Reaction Buttons -->
        <div style="display: flex; gap: 6px; align-items: center;">
          <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 700;">Hype:</span>
          <button type="button" onclick="sendReaction('🔥')" class="reaction-btn">🔥</button>
          <button type="button" onclick="sendReaction('🏆')" class="reaction-btn">🏆</button>
          <button type="button" onclick="sendReaction('🎯')" class="reaction-btn">🎯</button>
          <button type="button" onclick="sendReaction('👏')" class="reaction-btn">👏</button>
          <button type="button" onclick="sendReaction('💥')" class="reaction-btn">💥</button>
        </div>
      </div>
    </div>

    <!-- Right: Interactive Match Pick'em & MVP Vote -->
    <div class="card" style="padding: 1.75rem; border-radius: 20px; border-color: rgba(56, 189, 248, 0.35); background: rgba(14, 19, 32, 0.95); display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 9999px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; font-size: 0.7rem; font-weight: 800;" class="mono">
          FAN MVP POLL & PREDICTION
        </div>
        <h3 style="font-size: 1.25rem; font-weight: 900; color: #fff; margin: 0.5rem 0 0.25rem;">
          Vote Match MVP (+75 XP)
        </h3>
        <p style="color: var(--text-muted); font-size: 0.8125rem; margin-bottom: 1.25rem;">
          Vote for the top performer in today's Grand Finals.
        </p>

        <!-- MVP Candidates -->
        <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.25rem;">
          <% const candidates = [
            { id: 'mvp_tenz', name: 'Nowhere "TenZ"', role: 'Duelist / Jett', stat: '28 Kills (1.75 K/D)' },
            { id: 'mvp_joker', name: 'Nowhere "Joker"', role: 'Initiator / Sova', stat: '14 Assists • 3 Clutches' },
            { id: 'mvp_sentinels', name: 'Sentinels "zekken"', role: 'Entry / Raze', stat: '21 Kills (1.30 K/D)' },
          ]; %>

          <% candidates.forEach(c => { %>
            <div onclick="voteMvp('<%= c.name %>')" style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 0.75rem 1rem; cursor: pointer; transition: all 0.2s ease; display: flex; justify-content: space-between; align-items: center;" class="mvp-card">
              <div>
                <div style="font-size: 0.9rem; font-weight: 800; color: #fff;"><%= c.name %></div>
                <div style="font-size: 0.75rem; color: #94a3b8;"><%= c.role %> &bull; <strong style="color: #38bdf8;"><%= c.stat %></strong></div>
              </div>
              <button type="button" style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8; padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.75rem;">
                Vote
              </button>
            </div>
          <% }); %>
        </div>

        <div id="mvp-voted-msg" style="display: <%= user.votedMvp ? 'block' : 'none' %>; background: rgba(48, 209, 88, 0.15); border: 1px solid rgba(48, 209, 88, 0.4); color: #30d158; padding: 0.65rem 1rem; border-radius: 8px; font-size: 0.8125rem; text-align: center;">
          ✓ Voted for <strong id="voted-player-name"><%= user.votedMvp || '' %></strong> (+75 XP awarded)
        </div>
      </div>

      <!-- Live Fan Chat Link -->
      <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.08); text-align: center;">
        <a href="https://discord.com" target="_blank" rel="noreferrer" style="color: #38bdf8; text-decoration: none; font-size: 0.8125rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
          <span>Join 45,000+ Fans on Discord Voice & Chat &rarr;</span>
        </a>
      </div>
    </div>

  </div>

  <!-- ========================================================================= -->
  <!-- 4. NOWHERE FAN REWARDS SHOP (REDEEM NOWHERE COINS)                        -->
  <!-- ========================================================================= -->
  <section id="rewards-shop-section" style="margin-bottom: 2.5rem;">
    <div class="card" style="padding: 2.25rem; border-radius: 24px; border: 1px solid rgba(245, 158, 11, 0.35); background: radial-gradient(ellipse at 50% 0%, rgba(245, 158, 11, 0.12) 0%, rgba(14, 19, 32, 0.95) 70%);">
      
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 12px; border-radius: 9999px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #f59e0b; font-size: 0.72rem; font-weight: 800; text-transform: uppercase;" class="mono">
            LOOT VAULT &bull; NOWHERE COINS REWARDS
          </div>
          <h2 style="font-size: 1.6rem; font-weight: 900; text-transform: uppercase; color: #fff; margin-top: 6px;">
            Nowhere Fan Store & Digital Loot
          </h2>
          <p style="color: var(--text-muted); font-size: 0.875rem;">
            Spend your earned Nowhere Coins on exclusive tournament passes, physical merchandise vouchers, and digital keys.
          </p>
        </div>

        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(245, 158, 11, 0.35); padding: 8px 16px; border-radius: 12px;" class="mono">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <div>
            <div style="font-size: 0.65rem; color: #94a3b8; text-transform: uppercase;">Your Balance</div>
            <div style="font-size: 1.2rem; font-weight: 900; color: #f59e0b;" id="shop-coins-display"><%= user.coins %> NC</div>
          </div>
        </div>
      </div>

      <!-- Shop Items Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        
        <!-- Item 1: VIP Pass -->
        <div style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="margin-bottom: 0.75rem;">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="12" x="2" y="6" rx="2"/>
                <path d="M12 12h.01"/>
                <path d="M17 12h.01"/>
                <path d="M7 12h.01"/>
              </svg>
            </div>
            <h3 style="font-size: 1.1rem; font-weight: 800; color: #fff; margin-bottom: 4px;">VIP Tournament Pass</h3>
            <p style="color: var(--text-muted); font-size: 0.8125rem; margin-bottom: 1rem;">
              Unlock 4K Clean Feed broadcast, ad-free viewing, and VIP Discord role.
            </p>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <span class="mono" style="font-weight: 800; color: #f59e0b; font-size: 0.95rem;">1,200 NC</span>
            <button type="button" onclick="redeemReward('vip_pass', 1200, 'VIP Tournament Pass')" class="redeem-btn">
              Redeem
            </button>
          </div>
        </div>

        <!-- Item 2: Pro Jersey -->
        <div style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="margin-bottom: 0.75rem;">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ff2a4b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
              </svg>
            </div>
            <h3 style="font-size: 1.1rem; font-weight: 800; color: #fff; margin-bottom: 4px;">Nowhere Pro Jersey 2026</h3>
            <p style="color: var(--text-muted); font-size: 0.8125rem; margin-bottom: 1rem;">
              100% off physical merchandise coupon for official competitive team jersey.
            </p>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <span class="mono" style="font-weight: 800; color: #f59e0b; font-size: 0.95rem;">2,500 NC</span>
            <button type="button" onclick="redeemReward('pro_jersey', 2500, 'Nowhere Pro Jersey 2026')" class="redeem-btn">
              Redeem
            </button>
          </div>
        </div>

        <!-- Item 3: In-Game Loot -->
        <div style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="margin-bottom: 0.75rem;">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
