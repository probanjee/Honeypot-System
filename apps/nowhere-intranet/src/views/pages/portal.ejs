<script>
  let selectedAvatar = '<%= user.avatar || "🎮" %>';

  async function claimDailyDrop() {
    const btn = document.getElementById('claim-drop-btn');
    if (!btn || btn.disabled) return;

    btn.textContent = 'Claiming Loot...';
    btn.disabled = true;

    try {
      const res = await fetch('/portal/claim-drop', { method: 'POST' });
      const data = await res.json();
      if (data.status === 'success' && data.user) {
        document.getElementById('user-coins-display').textContent = data.user.coins;
        const shopCoins = document.getElementById('shop-coins-display');
        if (shopCoins) shopCoins.textContent = data.user.coins + ' NC';
        document.getElementById('user-xp-display').textContent = data.user.xp;
        document.getElementById('user-maxxp-display').textContent = data.user.maxXp;

        const pct = Math.min(100, Math.round((data.user.xp / data.user.maxXp) * 100));
        document.getElementById('user-xp-bar').style.width = pct + '%';

        btn.textContent = '✓ Claimed for Today (+250 XP, +100 NC)';
        btn.style.background = 'rgba(255, 255, 255, 0.08)';
        btn.style.color = '#94a3b8';

        alert('Daily Drop Claimed!\n\n+250 XP Added to Passport\n+100 Nowhere Coins Credited');
      }
    } catch (err) {
      console.error(err);
      btn.textContent = 'Error Claiming Drop';
      btn.disabled = false;
    }
  }

  async function redeemReward(itemId, cost, itemName) {
    if (!confirm(`Redeem "${itemName}" for ${cost} Nowhere Coins?`)) return;

    try {
      const res = await fetch('/portal/redeem-reward', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ item_id: itemId, cost: cost, item_name: itemName })
      });
      const data = await res.json();
      if (data.status === 'success') {
        document.getElementById('user-coins-display').textContent = data.coins;
        const shopCoins = document.getElementById('shop-coins-display');
        if (shopCoins) shopCoins.textContent = data.coins + ' NC';

        const invBox = document.getElementById('user-inventory-box');
        const invList = document.getElementById('inventory-items-list');
        if (invBox && invList) {
          invBox.style.display = 'block';
          const itemEl = document.createElement('div');
          itemEl.style.cssText = 'display: flex; justify-content: space-between; align-items: center; background: rgba(18, 24, 38, 0.9); padding: 8px 14px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.8125rem;';
          itemEl.innerHTML = `<span style="color: #fff; font-weight: 700;">${itemName}</span><span class="mono" style="color: #38bdf8; background: rgba(56, 189, 248, 0.15); padding: 2px 8px; border-radius: 4px; font-weight: 800;">CODE: ${data.voucherCode}</span>`;
          invList.prepend(itemEl);
        }

        alert(`Redemption Successful!\n\nYou claimed: ${itemName}\nYour Voucher Code: ${data.voucherCode}\nCheck "My Claimed Loot Vault" below.`);
      } else {
        alert(data.message || 'Redemption failed. Check your Nowhere Coins balance.');
      }
    } catch (err) {
      console.error(err);
    }
  }

  function sendReaction(emoji) {
    const area = document.getElementById('floating-reactions-area');
    if (!area) return;

    const span = document.createElement('span');
    span.textContent = emoji;
    span.style.cssText = `position: absolute; bottom: 20px; left: ${Math.random() * 80 + 10}%; font-size: 2rem; animation: floatUp 1.8s ease-out forwards;`;
    area.appendChild(span);

    setTimeout(() => {
      span.remove();
    }, 1800);
  }

  function openProfileModal() {
    const modal = document.getElementById('profile-modal');
    if (modal) modal.style.display = 'flex';
  }

  function closeProfileModal() {
    const modal = document.getElementById('profile-modal');
    if (modal) modal.style.display = 'none';
  }

  function handleProfileBackdropClick(e) {
    if (e.target && e.target.id === 'profile-modal') closeProfileModal();
  }

  function selectModalAvatar(av) {
    selectedAvatar = av;
    ['🐍', '👑', '🦅', '⚡', '🎯', '🔥', '🐺', '🤖', '🦁', '⚔️'].forEach(a => {
      const el = document.getElementById('av-opt-' + a);
      if (el) el.style.borderColor = a === av ? 'var(--accent)' : 'rgba(255, 255, 255, 0.1)';
    });
  }

  async function saveProfileChanges() {
    const gamertag = document.getElementById('modal-gamertag-input').value;
    const clan = document.getElementById('modal-clan-input').value;
    const favoriteGame = document.getElementById('modal-game-input').value;

    try {
      const res = await fetch('/portal/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ avatar: selectedAvatar, gamertag, clan, favorite_game: favoriteGame })
      });
      const data = await res.json();
      if (data.status === 'success' && data.user) {
        document.getElementById('passport-avatar-display').textContent = data.user.avatar;
        document.getElementById('passport-gamertag-display').textContent = data.user.gamertag;
        document.getElementById('passport-clan-display').textContent = data.user.clan;
        document.getElementById('passport-game-display').textContent = data.user.favoriteGame;
        closeProfileModal();
      }
    } catch (err) {
      console.error(err);
    }
  }

  async function voteMvp(playerName) {
    try {
      const res = await fetch('/portal/vote-mvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ candidate: playerName })
      });
      const data = await res.json();
      if (data.status === 'success') {
        const votedMsg = document.getElementById('mvp-voted-msg');
        const votedName = document.getElementById('voted-player-name');
        if (votedMsg && votedName) {
          votedName.textContent = playerName;
          votedMsg.style.display = 'block';
        }
        alert(`Vote Counted!\n\nYou voted for ${playerName} as Match MVP.\n+75 XP awarded to your Fan Passport!`);
      }
    } catch (err) {
      console.error(err);
    }
  }

  function downloadAndroidApk() {
    const btn = document.getElementById('apk-download-btn');
    if (btn) {
      btn.innerHTML = '<span>Preparing Nowhere_v2.4_Beta.apk...</span>';
      setTimeout(() => {
        btn.innerHTML = '<span>APK Download Triggered!</span>';
        alert('Nowhere Esports Android App (v2.4 Beta)\n\nPackage: com.nowhereesports.mobile\nSize: 48.2 MB\n\nDownload queued for installation on your device!');
      }, 800);
    }
  }

  function reserveTestFlight() {
    const btn = document.getElementById('testflight-btn');
    if (btn) {
      btn.innerHTML = '<span>TestFlight Slot Reserved!</span>';
      btn.style.borderColor = '#30d158';
      btn.style.color = '#30d158';
      alert('Nowhere Esports iOS TestFlight\n\nYour slot has been reserved under your registered email.\nYou will receive an official TestFlight invite link shortly!');
    }
  }

  function openStreamModal(videoId, title, game, matchInfo) {
    const modal = document.getElementById('stream-modal');
    const iframe = document.getElementById('modal-youtube-iframe');
    const titleEl = document.getElementById('modal-stream-title');
    const gameEl = document.getElementById('modal-stream-game');
    const matchEl = document.getElementById('modal-stream-match-info');

    if (!modal || !iframe) return;

    if (titleEl) titleEl.textContent = title || 'Live Match Stream';
    if (gameEl) gameEl.textContent = (game ? game.toUpperCase() + ' • ' : '') + 'NOWHERE LIVE THEATER';
    if (matchEl && matchInfo) matchEl.textContent = matchInfo;

    iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&rel=0';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeStreamModal() {
    const modal = document.getElementById('stream-modal');
    const iframe = document.getElementById('modal-youtube-iframe');
    if (iframe) iframe.src = '';
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = 'auto';
  }

  function handleModalBackdropClick(event) {
    if (event.target && event.target.id === 'stream-modal') {
      closeStreamModal();
    }
  }
</script>

