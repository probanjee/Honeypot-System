<%- include('../layouts/header', { title: 'Administrative Gateway' }) %>

<div style="max-width: 460px; margin: 3rem auto;">
  <div class="card" style="padding: 2.5rem 2rem; border-color: rgba(255, 145, 0, 0.4); box-shadow: 0 0 20px rgba(255, 145, 0, 0.05);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #ff9100, #ff3d00); border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; color: #fff;">🔒</div>
      <h1 style="font-size: 1.6rem; font-weight: 700; color: #ffb74d;">Administrative Console</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Level 4 Infrastructure & Tournament Controller Login</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: rgba(255, 23, 68, 0.15); border: 1px solid var(--danger); color: #ff80ab; padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1.5rem;">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div style="margin-bottom: 1.25rem;">
        <label for="admin_user" style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.4rem; font-weight: 500;">Admin Identifier</label>
        <input type="text" id="admin_user" name="username" required autocomplete="username" style="width: 100%; background: var(--bg-secondary); border: 1px solid var(--border); padding: 0.7rem 1rem; border-radius: 6px; color: #fff; font-size: 0.95rem;">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label for="admin_pass" style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.4rem; font-weight: 500;">Hardware Token / Master Secret</label>
        <input type="password" id="admin_pass" name="password" required autocomplete="current-password" style="width: 100%; background: var(--bg-secondary); border: 1px solid var(--border); padding: 0.7rem 1rem; border-radius: 6px; color: #fff; font-size: 0.95rem;">
      </div>

      <button type="submit" style="width: 100%; background: linear-gradient(135deg, #ff9100, #ff3d00); color: #fff; border: none; padding: 0.75rem; border-radius: 6px; font-weight: 700; font-size: 1rem; cursor: pointer;">
        Authenticate Administrative Session
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.75rem; color: #ff9100;">
      WARNING: Unauthorized connection to Nowhere Esports root controllers is a federal offense under 18 U.S.C. &sect; 1030.
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
