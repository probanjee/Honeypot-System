<%- include('../layouts/header', { title: 'Administrative Gateway' }) %>

<div style="max-width: 480px; margin: 3.5rem auto;">
  <div class="card" style="padding: 2.5rem 2rem; border-color: rgba(255, 159, 10, 0.4); box-shadow: 0 0 35px rgba(255, 159, 10, 0.1);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <img src="/images/nowhere-logo.png" alt="Nowhere Esports Logo" style="height: 64px; width: auto; margin-bottom: 1rem; filter: drop-shadow(0 0 16px rgba(255, 159, 10, 0.4));" />
      <h1 style="font-size: 1.6rem; font-weight: 800; color: #ffb74d; text-transform: uppercase;">Administrative Console</h1>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 4px;">Level 4 Infrastructure & Tournament Controller Login</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: rgba(255, 23, 68, 0.15); border: 1px solid var(--danger); color: #ff80ab; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.875rem; margin-bottom: 1.5rem;">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div style="margin-bottom: 1.25rem;">
        <label for="admin_user" style="display: block; font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.4rem; font-weight: 600;">Admin Identifier</label>
        <input type="text" id="admin_user" name="username" required autocomplete="username" style="width: 100%; background: rgba(8, 12, 22, 0.8); border: 1px solid var(--border); padding: 0.75rem 1rem; border-radius: 8px; color: #fff; font-size: 0.95rem; outline: none;">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label for="admin_pass" style="display: block; font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.4rem; font-weight: 600;">Hardware Token / Master Secret</label>
        <input type="password" id="admin_pass" name="password" required autocomplete="current-password" style="width: 100%; background: rgba(8, 12, 22, 0.8); border: 1px solid var(--border); padding: 0.75rem 1rem; border-radius: 8px; color: #fff; font-size: 0.95rem; outline: none;">
      </div>

      <button type="submit" style="width: 100%; background: linear-gradient(135deg, #ff9100, #ff3d00); color: #fff; border: none; padding: 0.85rem; border-radius: 8px; font-weight: 800; font-size: 0.95rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; box-shadow: 0 4px 16px rgba(255, 145, 0, 0.35);">
        Authenticate Administrative Session
      </button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.75rem; color: #ff9100;">
      WARNING: Unauthorized connection to Nowhere Esports root controllers is a federal offense under 18 U.S.C. &sect; 1030.
    </div>


  </div>
</div>

<%- include('../layouts/footer') %>
