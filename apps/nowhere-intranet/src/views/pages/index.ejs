<!-- ========================================================================= -->
<!-- CLIENT-SIDE API FETCH, STREAM MODAL & TOURNAMENT MANAGER SCRIPT           -->
<!-- ========================================================================= -->
<script>
  let allTournamentsCache = [];

  async function fetchLiveTournaments(manual = false) {
    const refreshIcon = document.getElementById('refresh-icon');

    if (refreshIcon && manual) {
      refreshIcon.style.display = 'inline-block';
      refreshIcon.style.transform = 'rotate(180deg)';
      refreshIcon.style.transition = 'transform 0.4s ease';
      setTimeout(() => { refreshIcon.style.transform = 'none'; }, 400);
    }

    try {
      const response = await fetch('/api/v1/tournaments');
      if (!response.ok) {
        throw new Error('API returned status ' + response.status);
      }

      const payload = await response.json();
      if (payload && Array.isArray(payload.data)) {
        allTournamentsCache = payload.data;
        onFilterChange();
      }
    } catch (err) {
      console.error('Failed to sync live tournaments:', err);
    }
  }

  function onFilterChange() {
    const gameSelect = document.getElementById('game-filter-select');
    const statusSelect = document.getElementById('status-filter-select');
    const searchInput = document.getElementById('tournament-search-input');
    const resultsBadge = document.getElementById('filter-results-badge');

    const selectedGame = gameSelect ? gameSelect.value : 'ALL';
    const selectedStatus = statusSelect ? statusSelect.value : 'ALL';
    const searchQuery = searchInput ? searchInput.value.trim().toLowerCase() : '';

    let filtered = allTournamentsCache;

    // 1. Filter by Game
    if (selectedGame && selectedGame !== 'ALL') {
      filtered = filtered.filter(t => 
        (t.game && t.game.toLowerCase().includes(selectedGame.toLowerCase())) ||
        (t.game_slug && t.game_slug.toLowerCase() === selectedGame.toLowerCase())
      );
    }

    // 2. Filter by Status
    if (selectedStatus && selectedStatus !== 'ALL') {
      filtered = filtered.filter(t => t.status === selectedStatus);
    }

    // 3. Search Keyword Filter
    if (searchQuery) {
      filtered = filtered.filter(t => 
        (t.title && t.title.toLowerCase().includes(searchQuery)) ||
        (t.game && t.game.toLowerCase().includes(searchQuery)) ||
        (t.region && t.region.toLowerCase().includes(searchQuery)) ||
        (t.current_match && t.current_match.toLowerCase().includes(searchQuery))
      );
    }

    // Update results count badge
    if (resultsBadge) {
      resultsBadge.textContent = `Showing ${filtered.length} Active Tournaments`;
    }

    renderTournaments(filtered);
  }

  function renderTournaments(tournaments) {
    const grid = document.getElementById('live-tournaments-grid');
    if (!grid) return;

    if (tournaments.length === 0) {
      grid.innerHTML = `
        <div class="card" style="grid-column: 1 / -1; padding: 3rem; text-align: center; border-radius: 20px;">
          <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem; color: #fff;">No Live Tournaments Found</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
            No ongoing tournament brackets currently match your selection.
          </p>
          <button onclick="resetAllFilters()" style="background: var(--accent); color: #fff; border: none; padding: 0.65rem 1.5rem; border-radius: 8px; font-weight: 700; cursor: pointer;">
            ↺ Reset Filters
          </button>
        </div>
      `;
      return;
    }

    grid.innerHTML = tournaments.map(t => {
      const accent = t.accent_color || '#ff2a4b';
      const isLive = t.status === 'LIVE_NOW' || t.status === 'ACTIVE';
      const statusBadge = isLive 
        ? `<span class="live-pulse-badge" style="background: rgba(48, 209, 88, 0.18); color: #30d158; border: 1px solid rgba(48, 209, 88, 0.4); padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.72rem; font-weight: 800; display: inline-flex; align-items: center; gap: 5px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #30d158; display: inline-block;"></span>
            ${t.status_label || 'LIVE NOW'}
          </span>`
        : `<span style="background: rgba(255, 159, 10, 0.18); color: #ff9f0a; border: 1px solid rgba(255, 159, 10, 0.4); padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.72rem; font-weight: 800;">
            ${t.status_label || t.status || 'SCHEDULED'}
          </span>`;

      const videoId = t.stream_video_id || '5W8f7m4X6lI';

      return `
        <div class="card" style="border-left: 4px solid ${accent}; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; position: relative; border-radius: 18px;">
          <div>
            <!-- Top Metadata Row -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.85rem; gap: 8px;">
              <div>
                <span class="mono" style="font-size: 0.72rem; color: ${accent}; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;">
                  ${t.game} &bull; ${t.region}
                </span>
                <h3 style="font-size: 1.3rem; font-weight: 800; margin-top: 4px; line-height: 1.25; color: #fff;">
                  ${t.title}
                </h3>
              </div>
              <div style="flex-shrink: 0;">
                ${statusBadge}
              </div>
            </div>

            <!-- Match stats callout -->
            <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 0.9rem 1.1rem; margin-bottom: 1.25rem;">
              <div style="font-size: 0.84rem; font-weight: 700; color: #f8fafc; margin-bottom: 4px;">
                ${t.current_match || 'Competitive Championship in Progress'}
              </div>
              <div class="mono" style="font-size: 0.75rem; color: var(--text-muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px;">
                <span>${t.current_map || t.bracket_type}</span>
                <span style="color: ${accent}; font-weight: 700;">${t.viewers ? t.viewers + ' Watching' : '16 Teams'}</span>
              </div>
            </div>
          </div>

          <!-- Real Esports Action Footer (No demo JSON links) -->
          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.8125rem;">
            <div>
              <span class="mono" style="font-size: 0.7rem; color: var(--text-muted); display: block;">PRIZE POOL</span>
              <strong class="mono" style="color: #fff; font-size: 1.05rem;">
                ${t.prize_formatted || ('$' + (t.prize_usd || 0).toLocaleString() + ' USD')}
              </strong>
            </div>
            <div style="display: flex; gap: 8px;">
              <button onclick="openStreamModal('${videoId}', '${t.title.replace(/'/g, "\\'")}', '${t.game}', '${accent}')" style="background: rgba(255, 42, 75, 0.18); border: 1px solid rgba(255, 42, 75, 0.45); color: #ff4767; padding: 0.45rem 0.85rem; border-radius: 8px; font-weight: 800; font-size: 0.76rem; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                ▶ Watch Stream
              </button>
              <a href="/register?game=${encodeURIComponent(t.game)}" style="background: ${accent}; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.76rem; padding: 0.45rem 0.85rem; border-radius: 8px;">
                Register
              </a>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  // YouTube Stream Modal Functions
  function openStreamModal(videoId, title, game, accent) {
    const modal = document.getElementById('stream-modal');
    const iframe = document.getElementById('modal-youtube-iframe');
    const titleEl = document.getElementById('modal-stream-title');
    const badgeEl = document.getElementById('modal-game-badge');
    const regBtn = document.getElementById('modal-register-btn');

    if (titleEl) titleEl.textContent = title || 'Live Esports Broadcast';
    if (badgeEl) {
      badgeEl.textContent = game ? (game.toUpperCase() + ' OFFICIAL STREAM') : 'OFFICIAL ESPORTS FEED';
      badgeEl.style.color = accent || '#38bdf8';
    }
    if (regBtn && game) {
      regBtn.href = '/register?game=' + encodeURIComponent(game);
    }

    if (iframe) {
      // Using YouTube Privacy-Enhanced Mode (youtube-nocookie.com)
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&rel=0&modestbranding=1';
    }

    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeStreamModal() {
    const modal = document.getElementById('stream-modal');
    const iframe = document.getElementById('modal-youtube-iframe');

    if (iframe) iframe.src = '';
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = 'auto';
    }
  }

  function applyGameFilter(gameName) {
    const gameSelect = document.getElementById('game-filter-select');
    if (gameSelect) {
      gameSelect.value = gameName;
    }
    onFilterChange();

    const targetSection = document.getElementById('live-tournaments-section');
    if (targetSection) {
      targetSection.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function resetAllFilters() {
    const gameSelect = document.getElementById('game-filter-select');
    const statusSelect = document.getElementById('status-filter-select');
    const searchInput = document.getElementById('tournament-search-input');

    if (gameSelect) gameSelect.value = 'ALL';
    if (statusSelect) statusSelect.value = 'ALL';
    if (searchInput) searchInput.value = '';

    onFilterChange();
  }

  // Initial fetch on page load
  document.addEventListener('DOMContentLoaded', () => {
    fetchLiveTournaments();
    // Auto refresh every 15 seconds to simulate live match score stream
    setInterval(() => {
      fetchLiveTournaments();
    }, 15000);
  });
</script>

