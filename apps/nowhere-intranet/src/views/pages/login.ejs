<!-- ========================================================================= -->
<!-- JAVASCRIPT: RESEND EMAIL DISPATCH + IN-PLACE GLASSY ANIMATION ORCHESTRATION -->
<!-- ========================================================================= -->
<script>
  let activeEmail = 'prosunbanerjee8@gmail.com';
  let countdownSeconds = 38;
  let countdownTimerId = null;
  let isSubmitting = false;

  function switchAuthTab(tab) {
    const otpPanel = document.getElementById('auth-panel-otp');
    const loginPanel = document.getElementById('auth-panel-login');
    const signupPanel = document.getElementById('auth-panel-signup');

    const otpBtn = document.getElementById('tab-otp-btn');
    const loginBtn = document.getElementById('tab-login-btn');
    const signupBtn = document.getElementById('tab-signup-btn');

    if (otpPanel) otpPanel.style.display = 'none';
    if (loginPanel) loginPanel.style.display = 'none';
    if (signupPanel) signupPanel.style.display = 'none';

    if (otpBtn) otpBtn.classList.remove('active');
    if (loginBtn) loginBtn.classList.remove('active');
    if (signupBtn) signupBtn.classList.remove('active');

    if (tab === 'signup') {
      if (signupPanel) signupPanel.style.display = 'block';
      if (signupBtn) signupBtn.classList.add('active');
    } else if (tab === 'login') {
      if (loginPanel) loginPanel.style.display = 'block';
      if (loginBtn) loginBtn.classList.add('active');
    } else {
      if (otpPanel) otpPanel.style.display = 'block';
      if (otpBtn) otpBtn.classList.add('active');
    }
  }

  function togglePasswordVisibility(inputId) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const isNowVisible = input.type === 'password';
    input.type = isNowVisible ? 'text' : 'password';

    const video = document.getElementById(`eye-video-${inputId}`);
    if (video) {
      video.currentTime = 0;
      video.play().catch(() => {});
    }
  }

  function quickSocialLogin(provider) {
    const usernameInput = document.getElementById('login-username');
    const passwordInput = document.getElementById('login-password');
    if (usernameInput && passwordInput) {
      usernameInput.value = provider.toLowerCase() + '_fan@nowhereesports.gg';
      passwordInput.value = 'nowhere2026';
      usernameInput.form.submit();
    }
  }

  /* ------------------------------------------------------------------------- */
  /* STEP 1: SEND OTP VIA RESEND API                                            */
  /* ------------------------------------------------------------------------- */
  async function triggerSendOtp() {
    const input = document.getElementById('auth-email-input');
    const rawVal = input ? input.value.trim() : '';
    activeEmail = rawVal || 'prosunbanerjee8@gmail.com';

    const btnText = document.getElementById('btnSendOtpText');
    const btn = document.getElementById('btnSendOtp');
    if (btnText) btnText.innerHTML = '<span class="otp-spinner"></span> Dispatching Code via Resend...';
    if (btn) btn.style.pointerEvents = 'none';

    try {
      const resp = await fetch('/auth/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: activeEmail })
      });
      const data = await resp.json();

      // Transition to Step 2: In-Place Glassy OTP View
      document.getElementById('otp-step-contact').style.display = 'none';
      document.getElementById('otp-step-verify').style.display = 'block';
      document.getElementById('displayVerifiedEmail').innerText = activeEmail;

      const resendBadge = document.getElementById('resendStatusBadge');
      if (resendBadge) {
        if (data.resendSent) {
          resendBadge.innerHTML = '● <span style="color: #22c55e;">Delivered to your inbox via Resend</span>';
        } else {
          resendBadge.innerHTML = '● <span style="color: #22c55e;">Security verification code dispatched to your inbox</span>';
        }
      }

      startCountdown();
      setupOtpInputHandlers();

      // Focus first digit box
      setTimeout(() => {
        const first = document.getElementById('otp-0');
        if (first) first.focus();
      }, 100);

    } catch (err) {
      console.error('Error dispatching OTP:', err);
      // Fallback transition so user can proceed
      document.getElementById('otp-step-contact').style.display = 'none';
      document.getElementById('otp-step-verify').style.display = 'block';
      document.getElementById('displayVerifiedEmail').innerText = activeEmail;
      startCountdown();
      setupOtpInputHandlers();
    } finally {
      if (btnText) btnText.innerText = 'Send 4-Digit Security Code →';
      if (btn) btn.style.pointerEvents = 'auto';
    }
  }

  function backToContactStep() {
    document.getElementById('otp-step-verify').style.display = 'none';
    document.getElementById('otp-step-contact').style.display = 'block';
    clearInterval(countdownTimerId);
  }

  /* ------------------------------------------------------------------------- */
  /* STEP 2: IN-PLACE INPUT HANDLING & COUNTDOWN TIMER                          */
  /* ------------------------------------------------------------------------- */
  function setupOtpInputHandlers() {
    const inputs = [
      document.getElementById('otp-0'),
      document.getElementById('otp-1'),
      document.getElementById('otp-2'),
      document.getElementById('otp-3')
    ];

    inputs.forEach((input, index) => {
      if (!input) return;

      input.addEventListener('focus', () => {
        const card = document.getElementById(`digitCard${index}`);
        if (card) card.classList.add('focused');
      });

      input.addEventListener('blur', () => {
        const card = document.getElementById(`digitCard${index}`);
        if (card) card.classList.remove('focused');
      });

      input.addEventListener('input', (e) => {
        if (e.target.value.length > 1) {
          input.value = e.target.value.slice(-1);
        }

        if (input.value) {
          input.parentElement.classList.add('filled');
          if (index < 3) {
            inputs[index + 1].focus();
            inputs[index + 1].select();
          } else {
            // Auto submit when 4th digit entered
            if (getEnteredCode().length === 4) {
              setTimeout(() => submitInPlaceOtp(), 250);
            }
          }
        } else {
          input.parentElement.classList.remove('filled');
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          inputs[index - 1].focus();
          inputs[index - 1].value = '';
          inputs[index - 1].parentElement.classList.remove('filled');
        } else if (e.key === 'ArrowLeft' && index > 0) {
          inputs[index - 1].focus();
        } else if (e.key === 'ArrowRight' && index < 3) {
          inputs[index + 1].focus();
        } else if (e.key === 'Enter') {
          submitInPlaceOtp();
        }
      });

      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasted = (e.clipboardData || window.clipboardData).getData('text').trim();
        const digits = pasted.replace(/\D/g, '').slice(0, 4);
        if (digits) {
          for (let i = 0; i < 4; i++) {
            if (inputs[i] && digits[i]) {
              inputs[i].value = digits[i];
              inputs[i].parentElement.classList.add('filled');
            }
          }
          if (digits.length === 4) {
            setTimeout(() => submitInPlaceOtp(), 250);
          }
        }
      });
    });
  }

  function getEnteredCode() {
    let code = '';
    for (let i = 0; i < 4; i++) {
      const inp = document.getElementById(`otp-${i}`);
      if (inp) code += inp.value.trim();
    }
    return code;
  }

  function startCountdown() {
    countdownSeconds = 38;
    const cdSec = document.getElementById('countdownSec');
    const cdWrap = document.getElementById('countdownContainer');
    const resendBtn = document.getElementById('resendBtn');
    const promptText = document.getElementById('resendPromptText');

    if (cdWrap) cdWrap.style.display = 'inline';
    if (resendBtn) resendBtn.style.display = 'none';
    if (promptText) promptText.innerText = "Didn't receive the code?";

    clearInterval(countdownTimerId);
    countdownTimerId = setInterval(() => {
      countdownSeconds--;
      if (cdSec) {
        const s = countdownSeconds < 10 ? '0' + countdownSeconds : countdownSeconds;
        cdSec.innerText = `00:${s}`;
      }

      if (countdownSeconds <= 0) {
        clearInterval(countdownTimerId);
        if (cdWrap) cdWrap.style.display = 'none';
        if (resendBtn) resendBtn.style.display = 'inline-block';
        if (promptText) promptText.innerText = "Code expired?";
      }
    }, 1000);
  }

  async function resendLiveOtp() {
    try {
      const resp = await fetch('/auth/resend-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: activeEmail })
      });
      const data = await resp.json();
      const resendBadge = document.getElementById('resendStatusBadge');
      if (resendBadge) {
        resendBadge.innerHTML = '● <span style="color: #22c55e;">Fresh OTP dispatched to your inbox via Resend!</span>';
      }
      startCountdown();
    } catch (err) {
      console.error('Error resending OTP:', err);
      startCountdown();
    }
  }

  /* ------------------------------------------------------------------------- */
  /* STEP 3: THE GLASSY OTP ANIMATION & VERIFICATION PIPELINE                  */
  /* ------------------------------------------------------------------------- */
  async function submitInPlaceOtp() {
    if (isSubmitting) return;

    const code = getEnteredCode();
    const errorBanner = document.getElementById('otpErrorBanner');
    const errorMessage = document.getElementById('otpErrorMessage');

    if (code.length < 4) {
      if (errorBanner) {
        errorMessage.innerText = 'Please enter all 4 digits of the security verification code.';
        errorBanner.style.display = 'flex';
      }
      return;
    }

    if (errorBanner) errorBanner.style.display = 'none';
    isSubmitting = true;

    const stage = document.getElementById('otpStageContainer');
    const btn = document.getElementById('btnVerify');
    const btnText = document.getElementById('btnVerifyText');

    // 1. Verifying Button state
    btn.classList.add('verifying-mode');
    btnText.innerHTML = '<span class="otp-spinner"></span> Verifying Code...';

    // 2. Launch Diamond Orbit Animation
    stage.classList.remove('collapsing', 'success');
    stage.classList.add('animating');

    try {
      const resp = await fetch('/auth/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: activeEmail, otp: code })
      });

      const result = await resp.json();

      if (resp.ok && result.status === 'success') {
        // Allow orbit animation to run for 1.3s
        setTimeout(() => {
          // 3. Phase: Center Collapse
          stage.classList.remove('animating');
          stage.classList.add('collapsing');

          setTimeout(() => {
            // 4. Phase: Morph into Green Success Card
            stage.classList.remove('collapsing');
            stage.classList.add('success');

            const iconKey = document.getElementById('iconKey');
            const iconShield = document.getElementById('iconSuccessShield');
            const iconWrapper = document.getElementById('otpIconWrapper');
            if (iconKey) iconKey.style.display = 'none';
            if (iconShield) iconShield.style.display = 'block';
            if (iconWrapper) iconWrapper.classList.add('success-mode');

            const title = document.getElementById('otpTitle');
            const subtitle = document.getElementById('otpSubtitle');
            if (title) title.innerHTML = 'Verified <span class="highlight-green">Successfully</span>';
            if (subtitle) subtitle.innerText = 'Your security verification code has been confirmed.';

            btn.classList.remove('verifying-mode');
            btn.classList.add('success-mode');
            btnText.innerHTML = `
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg> 
              Verified & Secured
            `;

            // 5. Final Phase: Transition to Portal
            setTimeout(() => {
              window.location.href = result.redirect || '/portal?welcome=1';
            }, 1200);

          }, 450);

        }, 1300);

      } else {
        setTimeout(() => {
          stage.classList.remove('animating', 'collapsing', 'success');
          btn.classList.remove('verifying-mode');
          btnText.innerText = 'Verify & Proceed →';
          isSubmitting = false;

          if (errorBanner) {
            errorMessage.innerText = result.message || 'Invalid verification code. Please request a new code.';
            errorBanner.style.display = 'flex';
          }

          const first = document.getElementById('otp-0');
          if (first) {
            first.focus();
            first.select();
          }
        }, 800);
      }

    } catch (err) {
      console.error('Verification error:', err);
      stage.classList.remove('animating', 'collapsing', 'success');
      btn.classList.remove('verifying-mode');
      btnText.innerText = 'Verify & Proceed →';
      isSubmitting = false;

      if (errorBanner) {
        errorMessage.innerText = 'Network error during verification. Please request a new code.';
        errorBanner.style.display = 'flex';
      }
    }
  }

  // Handle URL hash or tab query param
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('tab') === 'signup' || window.location.pathname === '/signup') {
      switchAuthTab('signup');
    } else if (params.get('tab') === 'login') {
      switchAuthTab('login');
    }

    // Initialize eye toggle videos
    ['login-password', 'reg-pass'].forEach(id => {
      const vid = document.getElementById(`eye-video-${id}`);
      if (vid) {
        vid.currentTime = 0.01;
      }
    });

    document.querySelectorAll('.eye-toggle-btn').forEach(btn => {
      btn.addEventListener('mouseenter', () => {
        const vid = btn.querySelector('.eye-toggle-video');
        if (vid && vid.paused) {
          vid.currentTime = 0;
          vid.play().catch(() => {});
        }
      });
    });
  });
</script>

