<%- include('../layouts/header', { title: 'Player & Fan Authentication' }) %>

<div style="max-width: 520px; margin: 3rem auto 4.5rem; position: relative; z-index: 2;">
  
  <!-- Outer Card with Glowing Glassmorphism Border -->
  <div class="card auth-main-card" id="authMainCard" style="padding: 2.75rem 2.25rem; border-radius: 28px; border: 1px solid rgba(255, 42, 75, 0.35); background: rgba(14, 19, 32, 0.95); box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75), 0 0 35px rgba(255, 42, 75, 0.15); backdrop-filter: blur(24px); position: relative; overflow: hidden;">
    
    <!-- Chamfered Decorative Glass Accents -->
    <div class="chamfer-corner chamfer-tl"></div>
    <div class="chamfer-corner chamfer-br"></div>

    <!-- Brand Logo & Header -->
    <div style="text-align: center; margin-bottom: 2rem;" id="authHeaderBlock">
      <div style="position: relative; display: inline-block; margin-bottom: 1.25rem;">
        <div style="position: absolute; inset: -15px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 42, 75, 0.4) 0%, transparent 70%); filter: blur(20px); pointer-events: none;"></div>
        <img src="/images/nowhere-logo.png" alt="Nowhere Esports Logo" style="height: 72px; width: auto; position: relative; filter: drop-shadow(0 0 18px rgba(255, 42, 75, 0.5));" />
      </div>

      <div style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 12px; border-radius: 9999px; background: rgba(255, 42, 75, 0.12); border: 1px solid rgba(255, 42, 75, 0.35); color: var(--accent); font-weight: 800; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.6rem;" class="mono">
        NOWHERE ESPORTS PASSPORT
      </div>

      <h1 style="font-size: 1.85rem; font-weight: 900; text-transform: uppercase; letter-spacing: -0.01em; color: #fff;">
        Fan & Player Portal
      </h1>
      <p style="color: var(--text-muted); font-size: 0.875rem; max-width: 420px; margin: 0.35rem auto 0;">
        Sign in with Gmail OTP or your competitive credentials to access live tournament streams and player passport.
      </p>
    </div>

    <!-- Alert Banners -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: rgba(255, 42, 75, 0.15); border: 1px solid var(--danger); color: #ff80ab; padding: 0.85rem 1.1rem; border-radius: 12px; font-size: 0.875rem; margin-bottom: 1.75rem; display: flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (typeof loggedOut !== 'undefined' && loggedOut) { %>
      <div style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8; padding: 0.85rem 1.1rem; border-radius: 12px; font-size: 0.875rem; margin-bottom: 1.75rem; display: flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>You have successfully signed out of your Nowhere session.</span>
      </div>
    <% } %>

    <% if (typeof welcome !== 'undefined' && welcome) { %>
      <div style="background: rgba(48, 209, 88, 0.15); border: 1px solid rgba(48, 209, 88, 0.4); color: #30d158; padding: 0.85rem 1.1rem; border-radius: 12px; font-size: 0.875rem; margin-bottom: 1.75rem; display: flex; align-items: center; gap: 8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Account created! Sign in with your new credentials below.</span>
      </div>
    <% } %>

    <!-- Segmented Tab Switcher -->
    <div id="authTabsNav" style="display: flex; background: rgba(8, 12, 22, 0.9); border: 1px solid rgba(255, 255, 255, 0.08); padding: 4px; border-radius: 12px; margin-bottom: 1.75rem; gap: 4px;">
      <button type="button" id="tab-otp-btn" onclick="switchAuthTab('otp')" class="auth-tab-btn active">
        Gmail / Mobile OTP
      </button>
      <button type="button" id="tab-login-btn" onclick="switchAuthTab('login')" class="auth-tab-btn">
        Password
      </button>
      <button type="button" id="tab-signup-btn" onclick="switchAuthTab('signup')" class="auth-tab-btn">
        Create Passport
      </button>
    </div>

    <!-- ===================================================================== -->
    <!-- TAB 1: GMAIL + MOBILE OTP FLOW (IN-PLACE 2-STEP WITH GLASSY ANIMATION) -->
    <!-- ===================================================================== -->
    <div id="auth-panel-otp" style="display: block;">
      
      <!-- STEP 1: Enter Gmail or Mobile to receive OTP -->
      <div id="otp-step-contact">
        <div style="margin-bottom: 1.5rem;">
          <label for="auth-email-input" style="display: block; font-size: 0.8125rem; color: #cbd5e1; margin-bottom: 0.4rem; font-weight: 700;">
            Gmail Address or Mobile Number *
          </label>
          <div style="position: relative;">
            <input type="text" id="auth-email-input" placeholder="e.g. prosunbanerjee8@gmail.com" required autocomplete="email" class="auth-input" style="padding-left: 2.75rem;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none;">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
        </div>

        <!-- Send Code Button -->
        <button type="button" id="btnSendOtp" onclick="triggerSendOtp()" style="width: 100%; background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); color: #0f172a; border: none; padding: 0.85rem; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; box-shadow: 0 4px 18px rgba(245, 158, 11, 0.35); transition: all 0.2s ease; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: center; gap: 8px;">
          <span id="btnSendOtpText">Send 4-Digit Security Code →</span>
        </button>

        <!-- One Click Pass / Join as Guest ID -->
        <div style="margin-bottom: 1.75rem; padding: 1.1rem; border-radius: 14px; background: rgba(56, 189, 248, 0.08); border: 1px dashed rgba(56, 189, 248, 0.4); text-align: center;">
          <div style="font-size: 0.72rem; color: #38bdf8; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;" class="mono">
            One Click Pass
          </div>
          <form action="/login" method="POST" style="margin: 0;">
            <input type="hidden" name="is_guest" value="true">
            <button type="submit" style="width: 100%; background: linear-gradient(135deg, rgba(56, 189, 248, 0.22) 0%, rgba(37, 99, 235, 0.25) 100%); border: 1px solid rgba(56, 189, 248, 0.55); color: #fff; padding: 0.75rem 1rem; border-radius: 10px; font-weight: 800; font-size: 0.875rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(56, 189, 248, 0.2);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              <span>Join as a Guest ID →</span>
            </button>
          </form>
        </div>

        <!-- Social Logins -->
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
          <div style="flex: 1; height: 1px; background: rgba(255, 255, 255, 0.1);"></div>
          <span style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 700;" class="mono">Or Connect With</span>
          <div style="flex: 1; height: 1px; background: rgba(255, 255, 255, 0.1);"></div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
          <button type="button" onclick="quickSocialLogin('Discord')" class="social-auth-btn">
            <span>Discord</span>
          </button>
          <button type="button" onclick="quickSocialLogin('Steam')" class="social-auth-btn">
            <span>Steam</span>
          </button>
          <button type="button" onclick="quickSocialLogin('Google')" class="social-auth-btn">
            <span>Google</span>
          </button>
        </div>

      </div>

      <!-- STEP 2: IN-PLACE GLASSY OTP ANIMATION VERIFICATION -->
      <div id="otp-step-verify" style="display: none; animation: fadeInStage 0.3s ease;">
        
        <!-- Header: Key Icon & Title -->
        <div style="text-align: center; margin-bottom: 1.5rem;">
          
          <div class="otp-icon-wrapper" id="otpIconWrapper">
            <!-- Golden Key SVG -->
            <svg id="iconKey" class="otp-icon-svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21 2-2 2m-1.5 1.5L14 9M9.5 14.5l-2.5 2.5a3.535 3.535 0 1 1-5-5l2.5-2.5a3.535 3.535 0 0 1 5 0l2 2Z"/>
              <circle cx="16" cy="8" r="1.5"/>
            </svg>

            <!-- Emerald Shield Check SVG -->
            <svg id="iconSuccessShield" class="otp-icon-svg" style="display: none;" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>

          <h2 class="otp-title" id="otpTitle" style="font-size: 1.6rem; font-weight: 800; margin: 0 0 0.4rem; color: #fff;">
            Verify <span class="highlight-gold" id="otpHighlightWord">OTP</span>
          </h2>

          <p class="otp-subtitle" id="otpSubtitle" style="color: #94a3b8; font-size: 0.85rem; margin: 0 auto 0.6rem;">
            Enter the 4-digit security code sent to your device
          </p>

          <div class="otp-email-pill" style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; border-radius: 9999px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); font-size: 0.8rem; color: #cbd5e1; margin-bottom: 0.5rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span id="displayVerifiedEmail" class="mono">prosunbanerjee8@gmail.com</span>
            <button type="button" onclick="backToContactStep()" style="background: none; border: none; color: #38bdf8; cursor: pointer; font-size: 0.75rem; font-weight: 700; padding: 0 4px; text-decoration: underline;" title="Change Email">Edit</button>
          </div>

          <div id="resendStatusBadge" style="font-size: 0.75rem; color: #22c55e; font-weight: 600; margin-top: 2px;">
            ● Delivered via Resend to your Gmail inbox
          </div>

        </div>

        <!-- Error Alert -->
        <div id="otpErrorBanner" class="otp-error-alert" style="display: none; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 0.65rem 1rem; border-radius: 12px; font-size: 0.8rem; align-items: center; gap: 8px; margin-bottom: 1.25rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="otpErrorMessage">Invalid verification code. Please check your Gmail or request a new code.</span>
        </div>

        <!-- The 4-Digit Input & Animation Stage Container -->
        <div class="otp-stage-container" id="otpStageContainer">
          
          <div class="otp-orbit-center" id="otpOrbitCenter">
            
            <!-- Box 0 (Top in Diamond) -->
            <div class="otp-digit-card" id="digitCard0" data-pos="0">
              <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-field" id="otp-0" autocomplete="off">
              <div class="box-glow-ring"></div>
            </div>

            <!-- Box 1 (Left in Diamond) -->
            <div class="otp-digit-card" id="digitCard1" data-pos="1">
              <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-field" id="otp-1" autocomplete="off">
              <div class="box-glow-ring"></div>
            </div>

            <!-- Box 2 (Right in Diamond) -->
            <div class="otp-digit-card" id="digitCard2" data-pos="2">
              <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-field" id="otp-2" autocomplete="off">
              <div class="box-glow-ring"></div>
            </div>

            <!-- Box 3 (Bottom in Diamond) -->
            <div class="otp-digit-card" id="digitCard3" data-pos="3">
              <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="otp-field" id="otp-3" autocomplete="off">
              <div class="box-glow-ring"></div>
            </div>

            <!-- Center Success Checkmark Box -->
            <div class="otp-success-card" id="otpSuccessCard">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <div class="success-glow-ring"></div>
            </div>

          </div>

        </div>

        <!-- Countdown & Resend Section -->
        <div style="text-align: center; margin-bottom: 1.5rem; font-size: 0.8125rem; color: #94a3b8;">
          <span id="resendPromptText">Didn't receive the code?</span>
          <span id="countdownContainer">
            Resend in <span class="mono" id="countdownSec" style="color: #f59e0b; font-weight: 700;">00:38</span>
          </span>
          <button type="button" id="resendBtn" onclick="resendLiveOtp()" style="display: none; background: none; border: none; color: #f59e0b; font-weight: 700; text-decoration: underline; cursor: pointer;">
            Resend Code
          </button>
        </div>

        <!-- Action Button -->
        <button type="button" id="btnVerify" class="btn-verify-otp" onclick="submitInPlaceOtp()">
          <span id="btnVerifyText">Verify & Proceed →</span>
        </button>

      </div>

    </div>

    <!-- ===================================================================== -->
    <!-- TAB 2: PASSWORD SIGN IN FORM                                         -->
    <!-- ===================================================================== -->
    <div id="auth-panel-login" style="display: none;">
      <form action="/login" method="POST">
        
        <div style="margin-bottom: 1.25rem;">
          <label for="login-username" style="display: block; font-size: 0.8125rem; color: #cbd5e1; margin-bottom: 0.4rem; font-weight: 700;">
            Gamertag, Username, or Email *
          </label>
          <input type="text" id="login-username" name="username" placeholder="e.g. ViperStrike or fan@nowhereesports.gg" required autocomplete="username" class="auth-input">
        </div>

        <div style="margin-bottom: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <label for="login-password" style="font-size: 0.8125rem; color: #cbd5e1; font-weight: 700;">
              Password *
            </label>
            <a href="#" onclick="switchAuthTab('otp'); return false;" style="font-size: 0.75rem; color: #38bdf8; text-decoration: none;">
              Sign in with OTP instead
            </a>
          </div>
          <div style="position: relative;">
            <input type="password" id="login-password" name="password" placeholder="••••••••" required autocomplete="current-password" class="auth-input" style="padding-right: 3rem;">
            <button type="button" onclick="togglePasswordVisibility('login-password')" class="eye-toggle-btn" title="Toggle password visibility">
              <video id="eye-video-login-password" class="eye-toggle-video" playsinline muted preload="auto">
                <source src="/images/eye-toggle.mp4" type="video/mp4">
                <source src="https://cdn-icons-mp4.flaticon.com/512/8121/8121254.mp4" type="video/mp4">
              </video>
            </button>
          </div>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; font-size: 0.8125rem; color: #94a3b8;">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="checkbox" name="remember" checked style="accent-color: var(--accent);">
            <span>Remember this device</span>
          </label>
        </div>

        <!-- Submit Button -->
        <button type="submit" style="width: 100%; background: linear-gradient(135deg, #ff2a4b 0%, #c8102e 100%); color: #fff; border: none; padding: 0.85rem; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; box-shadow: 0 4px 18px rgba(255, 42, 75, 0.45); transition: all 0.2s ease; margin-bottom: 1.25rem;">
          Sign In with Password
        </button>

      </form>

      <div style="font-size: 0.75rem; color: #94a3b8; text-align: center; margin-top: 6px;">
        Official Esports Account: <span class="mono" style="color: #cbd5e1;">fan@nowhereesports.gg</span> / <span class="mono" style="color: #cbd5e1;">nowhere2026</span>
      </div>

    </div>

    <!-- ===================================================================== -->
    <!-- TAB 3: CREATE FAN PASSPORT (SIGN UP)                                  -->
    <!-- ===================================================================== -->
    <div id="auth-panel-signup" style="display: none;">
      <form action="/auth/signup" method="POST">
        
        <div style="margin-bottom: 1.15rem;">
          <label for="reg-gamertag" style="display: block; font-size: 0.8125rem; color: #cbd5e1; margin-bottom: 0.4rem; font-weight: 700;">
            Competitive Gamertag / In-Game Name *
          </label>
          <input type="text" id="reg-gamertag" name="gamertag" placeholder="e.g. Apex_Ghost, ViperKing" required class="auth-input">
        </div>

        <div style="margin-bottom: 1.15rem;">
          <label for="reg-email" style="display: block; font-size: 0.8125rem; color: #cbd5e1; margin-bottom: 0.4rem; font-weight: 700;">
            Email Address *
          </label>
          <input type="email" id="reg-email" name="email" placeholder="e.g. player@domain.com" required autocomplete="email" class="auth-input">
        </div>

        <div style="margin-bottom: 1.15rem;">
          <label for="reg-pass" style="display: block; font-size: 0.8125rem; color: #cbd5e1; margin-bottom: 0.4rem; font-weight: 700;">
            Create Password *
          </label>
          <div style="position: relative;">
            <input type="password" id="reg-pass" name="password" placeholder="At least 6 characters" minlength="6" required class="auth-input" style="padding-right: 3rem;">
            <button type="button" onclick="togglePasswordVisibility('reg-pass')" class="eye-toggle-btn" title="Toggle password visibility">
              <video id="eye-video-reg-pass" class="eye-toggle-video" playsinline muted preload="auto">
                <source src="/images/eye-toggle.mp4" type="video/mp4">
                <source src="https://cdn-icons-mp4.flaticon.com/512/8121/8121254.mp4" type="video/mp4">
              </video>
            </button>
          </div>
        </div>

        <!-- Discipline & Region Selectors -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 1.25rem;">
          <div>
            <label style="display: block; font-size: 0.75rem; color: #cbd5e1; margin-bottom: 0.4rem; font-weight: 700;">
              Primary Game *
            </label>
            <select name="favorite_game" class="auth-input" style="padding: 0.65rem 0.8rem;">
              <option value="VALORANT">VALORANT</option>
              <option value="BGMI">BGMI</option>
              <option value="Free Fire">Free Fire MAX</option>
              <option value="eFootball">eFootball 2026</option>
              <option value="Counter-Strike 2">Counter-Strike 2</option>
              <option value="Apex Legends">Apex Legends</option>
              <option value="Call of Duty">Call of Duty</option>
              <option value="League of Legends">League of Legends</option>
            </select>
          </div>

          <div>
            <label style="display: block; font-size: 0.75rem; color: #cbd5e1; margin-bottom: 0.4rem; font-weight: 700;">
              Server Region *
            </label>
            <select name="region" class="auth-input" style="padding: 0.65rem 0.8rem;">
              <option value="India / South Asia">India / South Asia</option>
              <option value="APAC / Global">APAC / Global</option>
              <option value="Europe">Europe</option>
              <option value="Americas">Americas</option>
            </select>
          </div>
        </div>

        <!-- Fair Play Agreement -->
        <div style="margin-bottom: 1.5rem; font-size: 0.8125rem; color: #94a3b8; line-height: 1.4;">
          <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;">
            <input type="checkbox" required checked style="margin-top: 3px; accent-color: var(--accent);">
            <span>I agree to the Nowhere Esports <a href="/terms" style="color: #38bdf8;">Terms</a>, <a href="/privacy" style="color: #38bdf8;">Privacy Policy</a>, and Fair Play Rulebook.</span>
          </label>
        </div>

        <!-- Submit Button -->
        <button type="submit" style="width: 100%; background: linear-gradient(135deg, #ff2a4b 0%, #c8102e 100%); color: #fff; border: none; padding: 0.85rem; border-radius: 12px; font-weight: 800; font-size: 0.95rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; box-shadow: 0 4px 18px rgba(255, 42, 75, 0.45); transition: all 0.2s ease;">
          Create Fan Passport (+500 NC Bonus)
        </button>

      </form>
    </div>

  </div>
</div>

<!-- ========================================================================= -->
<!-- STYLES FOR GLASSY OTP ANIMATION & AUTH CARD                               -->
<!-- ========================================================================= -->
<style>
  @keyframes fadeInStage {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chamfer-corner {
    position: absolute;
    width: 38px;
    height: 38px;
    pointer-events: none;
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
  }
  .chamfer-tl {
    top: -1px;
    left: -1px;
    border-top-left-radius: 28px;
    border-bottom-right-radius: 18px;
    border-right-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
