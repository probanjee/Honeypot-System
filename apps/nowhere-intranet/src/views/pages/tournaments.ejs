    color: #64748b;
  }
  .match-meta {
    font-size: 0.72rem;
    color: #64748b;
    font-family: 'JetBrains Mono', monospace;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 5px;
    margin-top: 2px;
  }
  .status-live-dot {
    color: #ff2a4b;
    animation: livePulse 1s infinite alternate;
  }
  @keyframes livePulse {
    from { opacity: 0.6; }
    to { opacity: 1; }
  }
</style>

<script>
  function openBracketModal(id, title, game) {
    const modal = document.getElementById('bracket-modal');
    const titleEl = document.getElementById('modal-bracket-title');
    const gameEl = document.getElementById('modal-bracket-game');

    if (!modal) return;
    if (titleEl) titleEl.textContent = title ? `${title} — Official Bracket` : 'Tournament Championship Bracket';
    if (gameEl) gameEl.textContent = (game || 'ESPORTS') + ' • DOUBLE ELIMINATION';

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeBracketModal() {
    const modal = document.getElementById('bracket-modal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = 'auto';
  }

  function handleBracketBackdropClick(event) {
    if (event.target && event.target.id === 'bracket-modal') {
      closeBracketModal();
    }
  }

  function openStreamModal(videoId, title, game, matchInfo) {
    const modal = document.getElementById('stream-modal');
    const iframe = document.getElementById('modal-youtube-iframe');
    const titleEl = document.getElementById('modal-stream-title');
    const gameEl = document.getElementById('modal-stream-game');
    const matchEl = document.getElementById('modal-stream-match-info');
    const directLink = document.getElementById('modal-youtube-direct-link');

    if (!modal || !iframe) return;

    if (titleEl) titleEl.textContent = title || 'Live Tournament Broadcast';
    if (gameEl) gameEl.textContent = (game ? game.toUpperCase() + ' • ' : '') + 'NOWHERE ESPORTS LIVE BROADCAST';
    if (matchEl && matchInfo) matchEl.textContent = matchInfo;
    if (directLink) directLink.href = 'https://www.youtube.com/watch?v=' + videoId;

    // Use youtube-nocookie.com embed with autoplay=1
    iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&rel=0&modestbranding=1';

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeStreamModal() {
    const modal = document.getElementById('stream-modal');
    const iframe = document.getElementById('modal-youtube-iframe');

    if (iframe) iframe.src = '';
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = 'auto';
  }

  function handleModalBackdropClick(event) {
    if (event.target && event.target.id === 'stream-modal') {
      closeStreamModal();
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeStreamModal();
      closeBracketModal();
    }
  });
</script>

