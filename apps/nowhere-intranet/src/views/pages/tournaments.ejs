<%- include('../layouts/header', { title: 'Tournament Listings' }) %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 800;">Official Tournaments</h1>
    <p style="color: var(--text-muted);">Current season schedules, server allocations, and bracket rosters.</p>
  </div>
  <form action="/tournaments" method="GET" style="display: flex; gap: 0.5rem;">
    <input type="text" name="search" placeholder="Search tournament or game..." style="background: var(--bg-card); border: 1px solid var(--border); padding: 0.5rem 1rem; border-radius: 6px; color: #fff;">
    <button type="submit" style="background: var(--accent-cyan); color: #000; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; cursor: pointer;">Search</button>
  </form>
</div>

<div style="display: flex; flex-direction: column; gap: 1rem;">
  <% tournaments.forEach(function(t) { %>
    <div class="card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <div style="font-size: 0.8rem; color: var(--accent-cyan); font-weight: 600; text-transform: uppercase;"><%= t.game %> &bull; <%= t.region %></div>
        <h2 style="font-size: 1.3rem; font-weight: 700; margin: 0.25rem 0;"><%= t.title %></h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Format: <%= t.format %> &bull; Status: <%= t.status %></p>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 1.2rem; font-weight: 700; color: var(--success);"><%= t.prize_pool %></div>
        <a href="/api/v1/tournaments/<%= t.id %>" style="color: var(--accent-cyan); text-decoration: none; font-size: 0.85rem; font-weight: 600;">API JSON Data &rarr;</a>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../layouts/footer') %>
