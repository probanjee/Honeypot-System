<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/nowhere-logo.png">
  <title><%= title %> | Nowhere Esports Intranet</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #07090e;
      --bg-secondary: #0e1320;
      --bg-card: rgba(18, 24, 38, 0.75);
      --bg-card-hover: rgba(26, 36, 56, 0.9);
      --accent: #ff2a4b;
      --accent-hover: #ff4767;
      --accent-glow: rgba(255, 42, 75, 0.35);
      --accent-cyan: #38bdf8;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: rgba(255, 255, 255, 0.1);
      --border-red: rgba(255, 42, 75, 0.35);
      --success: #30d158;
      --warning: #ff9f0a;
      --danger: #ff453a;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-primary);
      color: var(--text-main);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow-x: hidden;
    }
    /* Ambient Neon Glow Orbs */
    body::before {
      content: '';
      position: fixed;
      top: -15%;
      left: 10%;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 42, 75, 0.12) 0%, transparent 70%);
      filter: blur(100px);
      pointer-events: none;
      z-index: 0;
    }
    body::after {
      content: '';
      position: fixed;
      bottom: -10%;
      right: 15%;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.08) 0%, transparent 70%);
      filter: blur(100px);
      pointer-events: none;
      z-index: 0;
    }
    header {
      background: rgba(14, 19, 32, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 0.85rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .logo-container {
      display: flex;
      align-items: center;
      gap: 1rem;
      text-decoration: none;
      color: var(--text-main);
    }
    .logo-img {
      height: 48px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 14px rgba(255, 42, 75, 0.45));
      transition: transform 0.25s ease;
    }
    .logo-container:hover .logo-img {
      transform: scale(1.05);
    }
    .logo-text {
      font-size: 1.25rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .logo-tag {
      font-size: 0.6875rem;
      color: var(--accent);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.08em;
    }
    nav ul {
      display: flex;
      list-style: none;
      gap: 1.25rem;
      align-items: center;
      flex-wrap: wrap;
    }
    nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    nav a:hover, nav a.active {
      color: #fff;
    }
    .btn-control {
      background: linear-gradient(135deg, rgba(255, 42, 75, 0.25) 0%, rgba(200, 16, 46, 0.35) 100%);
      border: 1px solid var(--border-red);
      border-top: 1px solid rgba(255, 255, 255, 0.4);
      color: #fff !important;
      padding: 0.45rem 1rem;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 0.8125rem;
      box-shadow: 0 0 14px rgba(255, 42, 75, 0.3);
      transition: all 0.25s ease;
    }
    .btn-control:hover {
      background: linear-gradient(135deg, rgba(255, 42, 75, 0.45) 0%, rgba(200, 16, 46, 0.55) 100%);
      box-shadow: 0 0 22px rgba(255, 42, 75, 0.55);
      transform: translateY(-1px);
    }
    .btn-soc {
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.15) 0%, rgba(37, 99, 235, 0.2) 100%);
      border: 1px solid rgba(56, 189, 248, 0.3);
      color: #38bdf8 !important;
      padding: 0.45rem 0.9rem;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 0.8125rem;
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
    }
    .btn-soc:hover {
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.25) 0%, rgba(37, 99, 235, 0.35) 100%);
      box-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
    }
    .btn-login {
      background: var(--accent);
      color: #fff !important;
      padding: 0.45rem 1.1rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.8125rem;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(255, 42, 75, 0.35);
    }
    .btn-login:hover {
      background: var(--accent-hover);
      box-shadow: 0 6px 18px rgba(255, 42, 75, 0.5);
    }
    main {
      flex: 1;
      padding: 2rem;
      max-width: 1300px;
      margin: 0 auto;
      width: 100%;
      position: relative;
      z-index: 10;
    }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      transition: all 0.25s ease;
    }
    .card:hover {
      border-color: rgba(255, 255, 255, 0.18);
    }
    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
  </style>
</head>
<body>
  <!-- ── NOWHERE ESPORTS PREMIUM ATMOSPHERIC LOADER ── -->
  <div id="nw-global-loader">
    <div class="nw-loader-bg-ambient"></div>
    <div class="nw-loader-scanlines"></div>
    <div class="nw-loader-content">
      
      <!-- Central Hologram & Ring -->
      <div class="nw-loader-emblem-wrap">
        <div class="nw-loader-pulse-ring ring-1"></div>
        <div class="nw-loader-pulse-ring ring-2"></div>
        <div class="nw-loader-orbit-dashed"></div>
        <div class="nw-loader-orbit-spinner"></div>
        <div class="nw-loader-orbit-spinner-reverse"></div>
        <div class="nw-loader-logo-box">
          <img src="/images/nowhere-logo.png" alt="Nowhere Esports Crest" class="nw-loader-logo" />
        </div>
      </div>

      <!-- Typography -->
      <div class="nw-loader-header">
        <div class="nw-loader-brand">NOWHERE ESPORTS</div>
        <div class="nw-loader-subbrand">TOURNAMENT NETWORK PROTOCOL // ACTIVE NODE</div>
      </div>

      <!-- Progress Track -->
      <div class="nw-loader-progress-card">
        <div class="nw-loader-progress-track">
          <div class="nw-loader-progress-fill" id="nwLoaderProgressFill">
            <div class="nw-loader-progress-glare"></div>
          </div>
        </div>
        <div class="nw-loader-stats">
          <div class="nw-loader-status-text" id="nwLoaderStatusText">INITIALIZING SECURE CLIENT...</div>
          <div class="nw-loader-percent" id="nwLoaderPercent">0%</div>
        </div>
      </div>

      <!-- Security / Protocol Watermark -->
      <div class="nw-loader-footer-meta">
        <div class="nw-meta-pill">
          <span class="nw-meta-dot"></span>
          <span>256-BIT TLS ENCRYPTED</span>
        </div>
        <div class="nw-meta-pill">
          <span>REGION: GLOBAL-APAC-01</span>
        </div>
        <div class="nw-meta-pill">
          <span>LATENCY: 4ms</span>
        </div>
      </div>

    </div>
  </div>

  <style>
    #nw-global-loader {
      position: fixed;
      inset: 0;
      z-index: 9999999;
      background: #05070b;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }
    #nw-global-loader.hidden {
      opacity: 0;
      transform: scale(1.02);
      pointer-events: none;
    }
    .nw-loader-bg-ambient {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 45%, rgba(255, 42, 75, 0.18) 0%, rgba(14, 19, 32, 0.6) 40%, #05070b 85%);
      pointer-events: none;
    }
    .nw-loader-scanlines {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 2px,
        rgba(0, 0, 0, 0.25) 2px,
        rgba(0, 0, 0, 0.25) 4px
      );
      pointer-events: none;
      opacity: 0.6;
    }
    .nw-loader-content {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-width: 480px;
      width: 90%;
    }
    /* Emblem Wrap & Holographic Rings */
    .nw-loader-emblem-wrap {
      position: relative;
      width: 140px;
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }
    .nw-loader-pulse-ring {
      position: absolute;
      inset: -15px;
      border-radius: 50%;
      border: 1px solid rgba(255, 42, 75, 0.35);
      animation: nwRingPulse 2.4s ease-out infinite;
      pointer-events: none;
    }
    .nw-loader-pulse-ring.ring-2 {
      animation-delay: 1.2s;
    }
    @keyframes nwRingPulse {
      0% { transform: scale(0.7); opacity: 0.8; }
      100% { transform: scale(1.4); opacity: 0; }
    }
    .nw-loader-orbit-dashed {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 2px dashed rgba(255, 42, 75, 0.3);
      animation: nwSpinClockwise 14s linear infinite;
    }
    .nw-loader-orbit-spinner {
      position: absolute;
      inset: -10px;
      border-radius: 50%;
      border: 3px solid transparent;
      border-top-color: #ff2a4b;
      border-right-color: rgba(255, 42, 75, 0.4);
      animation: nwSpinClockwise 1.6s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite;
      filter: drop-shadow(0 0 8px rgba(255, 42, 75, 0.8));
    }
    .nw-loader-orbit-spinner-reverse {
      position: absolute;
      inset: -18px;
      border-radius: 50%;
      border: 2px solid transparent;
      border-bottom-color: #38bdf8;
      border-left-color: rgba(56, 189, 248, 0.3);
      animation: nwSpinCounter 2.4s linear infinite;
      filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
    }
    @keyframes nwSpinClockwise {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes nwSpinCounter {
      from { transform: rotate(360deg); }
      to { transform: rotate(0deg); }
    }
    .nw-loader-logo-box {
      position: relative;
      z-index: 5;
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 42, 75, 0.25) 0%, rgba(14, 19, 32, 0.9) 80%);
      border: 1px solid rgba(255, 255, 255, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 35px rgba(255, 42, 75, 0.4), inset 0 0 20px rgba(0, 0, 0, 0.8);
      animation: nwLogoFloat 3s ease-in-out infinite;
    }
    @keyframes nwLogoFloat {
      0%, 100% { transform: translateY(0); filter: drop-shadow(0 0 15px rgba(255, 42, 75, 0.5)); }
      50% { transform: translateY(-4px); filter: drop-shadow(0 0 25px rgba(255, 42, 75, 0.85)); }
    }
    .nw-loader-logo {
      width: 58px;
      height: auto;
      object-fit: contain;
    }
    /* Typography */
    .nw-loader-header {
      margin-bottom: 22px;
    }
    .nw-loader-brand {
      font-size: 1.35rem;
      font-weight: 900;
      letter-spacing: 0.22em;
      color: #ffffff;
      text-transform: uppercase;
      text-shadow: 0 0 20px rgba(255, 42, 75, 0.6), 0 2px 4px rgba(0,0,0,0.8);
    }
    .nw-loader-subbrand {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6875rem;
      letter-spacing: 0.18em;
      color: #94a3b8;
      margin-top: 4px;
      text-transform: uppercase;
    }
    /* Progress Track */
    .nw-loader-progress-card {
      width: 100%;
      background: rgba(18, 24, 38, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 14px 18px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      margin-bottom: 20px;
      backdrop-filter: blur(12px);
    }
    .nw-loader-progress-track {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 9999px;
      overflow: hidden;
      position: relative;
      margin-bottom: 10px;
    }
    .nw-loader-progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #ff2a4b 0%, #ff4767 70%, #38bdf8 100%);
      border-radius: 9999px;
      position: relative;
      box-shadow: 0 0 14px rgba(255, 42, 75, 0.9);
      transition: width 0.15s ease-out;
    }
    .nw-loader-progress-glare {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
      animation: nwProgressGlare 1.5s infinite;
    }
    @keyframes nwProgressGlare {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
    .nw-loader-stats {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
    }
    .nw-loader-status-text {
      color: #cbd5e1;
      font-weight: 600;
      letter-spacing: 0.05em;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      max-width: 80%;
      text-align: left;
    }
    .nw-loader-percent {
      color: #ff4767;
      font-weight: 800;
    }
    /* Footer Meta */
    .nw-loader-footer-meta {
      display: flex;
      gap: 12px;
      align-items: center;
      justify-content: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.625rem;
      color: #64748b;
    }
    .nw-meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 3px 10px;
      border-radius: 6px;
      letter-spacing: 0.05em;
    }
    .nw-meta-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #30d158;
      box-shadow: 0 0 6px #30d158;
      animation: nwBlink 1.5s infinite;
    }
    @keyframes nwBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
  </style>

  <script>
    (function() {
      var loader = document.getElementById('nw-global-loader');
      if (!loader) return;

      var progressFill = document.getElementById('nwLoaderProgressFill');
      var percentText = document.getElementById('nwLoaderPercent');
      var statusText = document.getElementById('nwLoaderStatusText');

      var stages = [
        { at: 20, msg: 'ESTABLISHING SECURE PROTOCOLS...' },
        { at: 45, msg: 'SYNCING CHAMPIONSHIP BRACKETS...' },
        { at: 70, msg: 'AUTHENTICATING NETWORK CLIENT...' },
        { at: 90, msg: 'INITIALIZING STREAM NODES...' },
        { at: 100, msg: 'NODE SYNCHRONIZED // READY' }
      ];

      var currentProgress = 0;
      var duration = 950; // Smooth 950ms intro duration
      var startTime = performance.now();

      function update(now) {
        var elapsed = now - startTime;
        var rawRatio = Math.min(1, elapsed / duration);
        // Cubic ease out
        var progress = Math.floor((1 - Math.pow(1 - rawRatio, 3)) * 100);

        if (progress > currentProgress) {
          currentProgress = progress;
          if (progressFill) progressFill.style.width = currentProgress + '%';
          if (percentText) percentText.innerText = currentProgress + '%';

          for (var i = 0; i < stages.length; i++) {
            if (currentProgress <= stages[i].at) {
              if (statusText && statusText.innerText !== stages[i].msg) {
                statusText.innerText = stages[i].msg;
              }
              break;
            }
          }
        }

        if (rawRatio < 1) {
          requestAnimationFrame(update);
        } else {
          if (progressFill) progressFill.style.width = '100%';
          if (percentText) percentText.innerText = '100%';
          if (statusText) statusText.innerText = 'NODE SYNCHRONIZED // READY';

          setTimeout(function() {
            loader.classList.add('hidden');
            setTimeout(function() {
              if (loader.parentNode) loader.parentNode.removeChild(loader);
            }, 450);
          }, 150);
        }
      }

      requestAnimationFrame(update);
    })();
  </script>
  <header>
    <a href="/" class="logo-container">
      <img src="/images/nowhere-logo.png" alt="Nowhere Esports Logo" class="logo-img" />
      <div>
        <div class="logo-text">NOWHERE ESPORTS</div>
        <div class="logo-tag">Official Competitive Intranet</div>
      </div>
    </a>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/tournaments">Tournaments</a></li>
        <li><a href="/rosters">Pro Rosters</a></li>
        <li><a href="/register" style="color: #38bdf8; font-weight: 700;">Join Esports</a></li>
        <li><a href="/staff/directory">Staff Roster</a></li>
        <% if (typeof currentUser !== 'undefined' && currentUser && !currentUser.isGuest) { %>
          <li>
            <a href="/portal" style="color: #fff; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 42, 75, 0.15); border: 1px solid rgba(255, 42, 75, 0.4); padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.8125rem;">
              <span style="display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: rgba(255, 42, 75, 0.3); font-size: 0.7rem; font-weight: 800; color: #fff;"><%= (currentUser.gamertag || currentUser.username || 'P').charAt(0).toUpperCase() %></span>
              <span><%= currentUser.gamertag || currentUser.username %></span>
              <span style="font-size: 0.7rem; color: #f59e0b; background: rgba(0, 0, 0, 0.3); padding: 1px 6px; border-radius: 4px;">Lv.<%= currentUser.level || 1 %></span>
            </a>
          </li>
          <li><a href="/logout" style="color: #94a3b8; font-size: 0.8125rem; font-weight: 600;">Sign Out</a></li>
        <% } else { %>
          <li><a href="/login" class="btn-login">Sign In / Join</a></li>
        <% } %>
      </ul>
    </nav>
  </header>
  <main>
