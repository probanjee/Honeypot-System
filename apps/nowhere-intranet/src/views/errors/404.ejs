<%- include('../layouts/header', { title: '404 Not Found' }) %>

<div style="max-width: 580px; margin: 3rem auto 4.5rem; text-align: center;">
  <div class="card" style="padding: 2.5rem 2rem; border-color: rgba(255, 42, 75, 0.35); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 35px rgba(255, 42, 75, 0.15); border-radius: 24px;">
    
    <!-- Lottie Cat 404 Animation -->
    <div style="max-width: 340px; margin: 0 auto 1.25rem;">
      <lottie-player src="/animations/404.json" background="transparent" speed="1" style="width: 100%; height: 260px;" loop autoplay></lottie-player>
    </div>

    <div style="display: inline-flex; align-items: center; gap: 6px; padding: 3px 12px; border-radius: 9999px; background: rgba(255, 42, 75, 0.12); border: 1px solid rgba(255, 42, 75, 0.35); color: var(--accent); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.75rem;" class="mono">
      HTTP STATUS CODE 404 • ROUTE UNRESOLVED
    </div>

    <h1 style="font-size: 1.75rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.75rem; color: #fff;">
      <%= title || 'Resource Missing from Intranet Node' %>
    </h1>

    <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 440px; margin: 0 auto 2rem; line-height: 1.6;">
      <%= message || 'The requested Nowhere Esports resource, bracket, or endpoint does not exist or has been relocated to another competitive cluster.' %>
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn-login" style="display: inline-block; padding: 0.65rem 1.4rem;">Return to Home Hub</a>
      <a href="/tournaments" style="background: rgba(255, 255, 255, 0.08); border: 1px solid var(--border); color: #fff; padding: 0.65rem 1.25rem; border-radius: 8px; font-weight: 700; font-size: 0.8125rem; text-decoration: none;">Explore Tournaments</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
