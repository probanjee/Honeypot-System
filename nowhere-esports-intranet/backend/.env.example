# =============================================================================
# Nowhere Esports Intranet — Backend Environment Variables (PostgreSQL)
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/honeypot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=honeypot
DB_USER=user
DB_PASSWORD=password
DB_MAX_CONNECTIONS=20

# Authentication & Security
JWT_SECRET=nowhere-esports-super-secret-jwt-key-2026
JWT_EXPIRES_IN=24h

# Kafka Messaging (Publishes raw-attacks to Vigilance pipeline)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=nowhere-esports-backend

# CORS & Rate Limiting
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
