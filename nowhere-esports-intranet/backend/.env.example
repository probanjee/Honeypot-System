# =============================================================================
# Nowhere Esports Intranet — Backend Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development          # development | production | test
PORT=3001                     # HTTP port the backend listens on
API_VERSION=v1                # API version prefix: /api/<API_VERSION>/...

# ---------------------------------------------------------------------------
# Supabase — PostgreSQL + Auth + Storage + Realtime
# Get these from: https://app.supabase.com → Project Settings → API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in milliseconds
RATE_LIMIT_MAX=100            # Max requests per window per IP

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info                # trace | debug | info | warn | error | fatal
LOG_PRETTY=true               # true = human-readable (dev), false = JSON (prod)
